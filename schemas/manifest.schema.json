{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://afford-bench.org/schemas/manifest.schema.json",
  "title": "AFFORD-Bench Benchmark Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["benchmark_id", "benchmark_version", "protocol", "cases"],
  "properties": {
    "benchmark_id": {
      "type": "string",
      "const": "AFFORD-Bench"
    },
    "benchmark_version": {
      "type": "string",
      "minLength": 1
    },
    "track": {
      "enum": ["full", "lite", "frontier"]
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arms", "scoring_track", "safety_constraints"],
      "properties": {
        "arms": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 2,
          "maxItems": 2
        },
        "scoring_track": {
          "enum": ["physical_completion", "compliant_dynamic_completion"]
        },
        "safety_constraints": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_contact_force_n", "joint_torque_limits_nm"],
          "properties": {
            "max_contact_force_n": { "type": "number", "minimum": 0 },
            "joint_torque_limits_nm": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 7,
              "maxItems": 7
            }
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "domain_id",
          "domain_name",
          "task_id",
          "task_number",
          "policy_seed",
          "timing_bucket",
          "scenario"
        ],
        "properties": {
          "case_id": { "type": "string", "minLength": 1 },
          "domain_id": { "type": "string", "pattern": "^D[1-8]$" },
          "domain_name": { "type": "string", "minLength": 1 },
          "task_id": { "type": "string", "minLength": 1 },
          "task_number": { "type": "integer", "minimum": 1, "maximum": 240 },
          "policy_seed": { "type": "integer", "minimum": 0 },
          "timing_bucket": { "enum": ["early", "middle", "late"] },
          "scenario": { "$ref": "scenario.schema.json" }
        }
      }
    }
  }
}
